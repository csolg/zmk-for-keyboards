#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define LEFT_SIDE_KEYS LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define RIGHT_SIDE_KEYS RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMB_KEYS LH2 LH1 LH0 RH0 RH1 RH2

&gresc {
};

/ {
    behaviors {
        hml: homerow_left_mods {
            flavor = "balanced";
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;

            /* hold-trigger-key-positions = <KEYS_L THUMBS>; */

            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <36 37 38>;
        };

        hmr: homerow_right_mods {
            flavor = "balanced";
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;

            /* hold-trigger-key-positions = <KEYS_R THUMBS>; */

            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <39 40 41>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 6>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 18>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 29>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <31 30>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <28 27>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 8>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <31 32>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <3 4>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 12>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <24 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&gresc     &kp Q        &kp W         &kp E        &kp R         &kp T         &kp Y         &kp U          &kp I             &kp O         &kp P                &kp LEFT_BRACKET
&kp TAB    &hml LALT A  &hml LCTRL S  &hml LGUI D  &hml LSHFT F  &kp G         &kp H         &hmr RSHIFT J  &hmr RGUI K       &hmr RCTRL L  &hmr RALT SEMICOLON  &kp RIGHT_BRACKET
&kp GRAVE  &kp Z        &kp X         &kp C        &kp V         &kp B         &kp N         &kp M          &kp COMMA         &kp DOT       &kp FSLH             &kp APOSTROPHE
                                      &ltq 3 TAB   &ltq 1 SPACE  &ltq 2 ENTER  &ltq 2 ENTER  &ltq 1 SPACE   &ltq 4 BACKSPACE
            >;

            label = "Main";
        };

        sym {
            bindings = <
&trans  &kp F10        &kp F7         &kp F8        &kp F9          &trans  &kp PLUS      &kp N7          &kp N8        &kp N9         &kp SLASH     &trans
&trans  &hml LALT F11  &hml LCTRL F4  &hml LGUI F5  &hml LSHIFT F6  &trans  &kp MINUS     &hmr RSHIFT N4  &hmr RGUI N5  &hmr RCTRL N6  &kp ASTERISK  &trans
&trans  &kp F12        &kp F1         &kp F2        &kp F3          &trans  &kp NUMBER_0  &kp N1          &kp N2        &kp N3         &kp DOT       &trans
                                      &trans        &trans          &trans  &trans        &trans          &trans
            >;

            label = "Sym";
        };

        nav {
            bindings = <
&trans       &kp F10        &kp F7         &kp F8        &kp F9          &trans  &kp HOME  &kp PAGE_DOWN           &kp PAGE_UP         &kp END           &trans    &trans
&trans       &hml LALT F11  &hml LCTRL F4  &hml LGUI F5  &hml LSHIFT F6  &trans  &kp LEFT  &hmr RSHIFT DOWN_ARROW  &hmr RGUI UP_ARROW  &hmr RCTRL RIGHT  &kp RALT  &trans
&bootloader  &kp F12        &kp F1         &kp F2        &kp F3          &trans  &trans    &trans                  &trans              &trans            &trans    &bootloader
                                           &trans        &trans          &trans  &trans    &trans                  &trans
            >;

            label = "Nav";
        };

        sys {
            bindings = <
&trans  &bt BT_SEL 0       &bt BT_SEL 1          &bt BT_SEL 2              &bt BT_SEL 3    &bootloader       &bootloader  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_AUTO     &kp C_NEXT      &kp C_PLAY_PAUSE  &trans       &trans  &trans  &trans  &trans  &trans
&trans  &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_MINIMUM  &kp C_PREVIOUS  &trans            &trans       &trans  &trans  &trans  &trans  &trans
                                                 &trans                    &trans          &trans            &trans       &trans  &trans
            >;

            label = "Sys";
        };

        shorts {
            bindings = <
&trans  &trans      &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &trans  &trans          &kp LC(LG(N7))  &kp LC(LG(N8))  &kp LC(LG(N9))  &trans  &trans
&trans  &trans      &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &trans  &trans          &kp LC(LG(N4))  &kp LC(LG(N5))  &kp LC(LG(N6))  &trans  &trans
&trans  &kp LG(N0)  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &trans  &kp LC(LG(N0))  &kp LC(LG(N1))  &kp LC(LG(N2))  &kp LC(LG(N3))  &trans  &trans
                                &trans      &trans      &trans  &trans          &trans          &trans
            >;
        };
    };
};
