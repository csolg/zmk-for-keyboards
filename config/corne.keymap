#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&gresc {
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 6>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 18>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 29>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <31 30>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <4 3>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 8>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <27 28>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&gresc     &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I            &kp O       &kp P               &kp LEFT_BRACKET
&kp TAB    &hm LGUI A  &hm LALT S  &hm LSHFT D  &hm LCTRL F  &kp G        &kp H        &hm RCTRL J  &hm RSHFT K      &hm RALT L  &hm RGUI SEMICOLON  &kp RIGHT_BRACKET
&kp GRAVE  &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA        &kp DOT     &kp FSLH            &kp APOSTROPHE
                                   &lt 4 TAB    &lt 1 SPACE  &lt 2 ENTER  &lt 2 ENTER  &lt 1 SPACE  &lt 3 BACKSPACE
            >;

            label = "Main";
        };

        sym {
            bindings = <
&trans  &kp MINUS       &kp N7        &kp N8        &kp N9        &trans  &trans  &kp N7        &kp N8        &kp N9       &kp N0          &trans
&trans  &hm LGUI EQUAL  &hm LALT N4   &hm LSHFT N5  &hm LCTRL N6  &trans  &trans  &hm RCTRL N4  &hm RSHFT N5  &hm RALT N6  &hm RGUI MINUS  &trans
&trans  &kp N0          &kp NUMBER_1  &kp N2        &kp N3        &trans  &trans  &kp N1        &kp N2        &kp N3       &kp EQUAL       &trans
                                      &trans        &trans        &trans  &trans  &trans        &trans
            >;

            label = "Sym";
        };

        nav {
            bindings = <
&trans       &kp F10       &kp F7           &kp F8        &kp F9        &trans  &kp HOME  &kp PAGE_DOWN         &kp PAGE_UP         &kp END         &trans    &trans
&trans       &hm LGUI F11  &hm LEFT_ALT F4  &hm LSHFT F5  &hm LCTRL F6  &trans  &kp LEFT  &hm RCTRL DOWN_ARROW  &hm RSHFT UP_ARROW  &hm RALT RIGHT  &kp RGUI  &trans
&bootloader  &kp F12       &kp F1           &kp F2        &kp F3        &trans  &trans    &trans                &trans              &trans          &trans    &bootloader
                                            &trans        &trans        &trans  &trans    &trans                &trans
            >;

            label = "Nav";
        };

        sys {
            bindings = <
&trans  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR       &trans        &trans        &trans        &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &rgb_ug RGB_TOG  &bl BL_TOG    &trans        &trans        &trans       &trans       &trans  &trans  &trans  &trans  &trans
                                       &trans        &trans        &trans       &trans       &trans  &trans
            >;

            label = "Sys";
        };

        shortcuts {
            bindings = <
&trans  &kp LG(LC(NUMBER_1))  &kp LG(LC(NUMBER_2))  &kp LG(LC(NUMBER_3))   &kp LG(LC(NUMBER_4))  &kp LG(LC(NUMBER_5))  &kp RC(RG(NUMBER_6))  &kp RG(RC(NUMBER_7))  &kp RG(RC(NUMBER_8))  &kp RG(RC(NUMBER_9))  &kp RG(RC(NUMBER_0))  &msc SCRL_UP
&trans  &kp C_VOLUME_UP       &kp C_BRI_UP          &kp C_BRIGHTNESS_AUTO  &trans                &trans                &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_UP          &mmv MOVE_RIGHT       &trans                &trans
&trans  &kp C_VOLUME_DOWN     &kp C_BRI_DN          &kp C_BRI_MIN          &trans                &trans                &mmv MOVE_X(600)      &mmv MOVE_Y(600)      &mkp LCLK             &mkp MCLK             &mkp RCLK             &msc SCRL_DOWN
                                                    &trans                 &trans                &trans                &trans                &trans                &trans
            >;

            label = "Short";
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
