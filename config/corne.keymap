#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

#define LEFT_SIDE_KEYS LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define RIGHT_SIDE_KEYS RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMB_KEYS LH2 LH1 LH0 RH0 RH1 RH2

&gresc {
};

/ {
    behaviors {
        hml: homerow_left_mods {
            flavor = "balanced";
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT_MODS";

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_right_mods {
            flavor = "balanced";
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT_MODS";

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 6>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 18>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 29>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <31 30>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <4 3>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 8>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <27 28>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&gresc     &kp Q        &kp W        &kp E         &kp R         &kp T        &kp Y        &kp U         &kp I            &kp O        &kp P                &kp LEFT_BRACKET
&kp TAB    &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G        &kp H        &hmr RCTRL J  &hmr RSHFT K     &hmr RALT L  &hmr RGUI SEMICOLON  &kp RIGHT_BRACKET
&kp GRAVE  &kp Z        &kp X        &kp C         &kp V         &kp B        &kp N        &kp M         &kp COMMA        &kp DOT      &kp FSLH             &kp APOSTROPHE
                                     &lt 4 TAB     &lt 1 SPACE   &lt 2 ENTER  &lt 2 ENTER  &lt 1 SPACE   &lt 3 BACKSPACE
            >;

            label = "Main";
        };

        sym {
            bindings = <
&trans  &kp MINUS        &kp N7        &kp N8         &kp N9         &trans  &trans  &kp N7         &kp N8         &kp N9        &kp N0           &trans
&trans  &hml LGUI EQUAL  &hml LALT N4  &hml LSHFT N5  &hml LCTRL N6  &trans  &trans  &hmr RCTRL N4  &hmr RSHFT N5  &hmr RALT N6  &hmr RGUI MINUS  &trans
&trans  &kp N0           &kp NUMBER_1  &kp N2         &kp N3         &trans  &trans  &kp N1         &kp N2         &kp N3        &kp EQUAL        &trans
                                       &trans         &trans         &trans  &trans  &trans         &trans
            >;

            label = "Sym";
        };

        nav {
            bindings = <
&trans       &kp F10        &kp F7            &kp F8         &kp F9         &trans  &kp HOME  &kp PAGE_DOWN          &kp PAGE_UP          &kp END          &trans    &trans
&trans       &hml LGUI F11  &hml LEFT_ALT F4  &hml LSHFT F5  &hml LCTRL F6  &trans  &kp LEFT  &hmr RCTRL DOWN_ARROW  &hmr RSHFT UP_ARROW  &hmr RALT RIGHT  &kp RGUI  &trans
&bootloader  &kp F12        &kp F1            &kp F2         &kp F3         &trans  &trans    &trans                 &trans               &trans           &trans    &bootloader
                                              &trans         &trans         &trans  &trans    &trans                 &trans
            >;

            label = "Nav";
        };

        sys {
            bindings = <
&trans  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR       &trans        &trans        &trans        &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &rgb_ug RGB_TOG  &bl BL_TOG    &trans        &trans        &trans       &trans       &trans  &trans  &trans  &trans  &trans
                                       &trans        &trans        &trans       &trans       &trans  &trans
            >;

            label = "Sys";
        };

        shortcuts {
            bindings = <
&trans  &kp LG(LC(NUMBER_1))  &kp LG(LC(NUMBER_2))  &kp LG(LC(NUMBER_3))   &kp LG(LC(NUMBER_4))  &kp LG(LC(NUMBER_5))  &kp RC(RG(NUMBER_6))  &kp RG(RC(NUMBER_7))  &kp RG(RC(NUMBER_8))  &kp RG(RC(NUMBER_9))  &kp RG(RC(NUMBER_0))  &msc SCRL_UP
&trans  &kp C_VOLUME_UP       &kp C_BRI_UP          &kp C_BRIGHTNESS_AUTO  &trans                &trans                &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_UP          &mmv MOVE_RIGHT       &trans                &trans
&trans  &kp C_VOLUME_DOWN     &kp C_BRI_DN          &kp C_BRI_MIN          &trans                &trans                &mmv MOVE_X(600)      &mmv MOVE_Y(600)      &mkp LCLK             &mkp MCLK             &mkp RCLK             &msc SCRL_DOWN
                                                    &trans                 &trans                &trans                &trans                &trans                &trans
            >;

            label = "Short";
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
